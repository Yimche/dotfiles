#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    theme: "theme.ron",
    cache_dir: None,
    on_song_change: None,
    volume_step: 5,
    max_fps: 30,
    scrolloff: 8,
    wrap_navigation: false,
    enable_mouse: true,
    scroll_amount: 1,
    enable_config_hot_reload: true,
    enable_lyrics_hot_reload: true,
    lyrics_dir: "/home/julian/Music/albums_flac/",
    status_update_interval_ms: 1000,
    rewind_to_start_sec: None,
    keep_state_on_song_change: true,
    reflect_changes_to_playlist: false,
    select_current_song_on_change: true,
    ignore_leading_the: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    directories_sort: SortFormat(group_by_type: true, reverse: false),
    auto_open_downloads: true,
    album_art: (
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),
    keybinds: (
        clear: true,
        global: {
            ",":          SeekBack,
            "-":          VolumeDown,
            ".":          SeekForward,
            "1":          SwitchToTab("Queue"),
            "2":          SwitchToTab("Artists"),
            "3":          SwitchToTab("Albums"),
            "4":          SwitchToTab("Playlists"),
            "5":          SwitchToTab("Search"),
            ":":          CommandMode,
            "<":          PreviousTrack,
            "=":          VolumeUp,
            ">":          NextTrack,
            "?":          ShowHelp,
            "C":          ToggleSingle,
            "H":          PreviousTab,
            "L":          NextTab,
            "R":          AddRandom,
            "U":          Rescan,
            "b":          NextTrack,
            "c":          TogglePause,
            "oI":         ShowCurrentSongInfo,
            "oP":         Partition(),
            "od":         ShowDownloads,
            "oo":         ShowOutputs,
            "op":         ShowDecoders,
            "q":          Quit,
            "r":          ToggleRepeat,
            "s":          ToggleRandom,
            "u":          Update,
            "v":          Stop,
            "x":          TogglePause,
            "X":          ToggleConsume,
            "z":          PreviousTrack,
        },
        navigation: {
            "/":          EnterSearch,
            "<C-Down>":   PaneDown,
            "<C-Left>":   PaneLeft,
            "<C-Right>":  PaneRight,
            "<C-Space>":  InvertSelection,
            "<C-Up>":     PaneUp,
            "<C-b>":      PageUp,
            "<C-c>":      Close,
            "<C-d>":      DownHalf,
            "<C-f>":      PageDown,
            "<C-r>":      Rename,
            "<C-u>":      UpHalf,
            "<C-w>h":     PaneLeft,
            "<C-w>j":     PaneDown,
            "<C-w>k":     PaneUp,
            "<C-w>l":     PaneRight,
            "<C-z>":      ContextMenu(),
            "<CR>":       Confirm,
            "<Down>":     Down,
            "<Esc>":      Close,
            "<Left>":     Left,
            "<PageDown>": PageDown,
            "<PageUp>":   PageUp,
            "<Right>":    Right,
            "<Space>":    Select,
            "<Up>":       Up,
            "A":          AddAll,
            "D":          Delete,
            "G":          Bottom,
            "J":          MoveDown,
            "K":          MoveUp,
            "N":          PreviousResult,
            "a":          Add,
            "gg":         Top,
            "h":          Left,
            "i":          FocusInput,
            "j":          Down,
            "k":          Up,
            "l":          Right,
            "n":          NextResult,
            "oi":         ShowInfo,
            "Y":          Save(kind: Modal(all: true, duplicates_strategy: Ask)),
            "y":          Save(kind: Modal(all: false, duplicates_strategy: Ask)),
            //"r":          Rate(),
        },
        queue: {
            "d":          Delete,
            "D":          DeleteAll,
            "<CR>":       Play,
            //"C":          JumpToCurrent,
            "S":          Shuffle,
        },
    ),
    search: (
        case_sensitive: false,
        ignore_diacritics: false,
        custom_query: true,
        search_button: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
            (value: "filename",    label: "Filename"),
            (value: "genre",       label: "Genre"),
        ],
    ),
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
        album_date_tags: [Date],
    ),
    cava: (
        framerate: 60, // default 60
        autosens: true, // default true
        sensitivity: 100, // default 100
        lower_cutoff_freq: 50, // not passed to cava if not provided
        higher_cutoff_freq: 10000, // not passed to cava if not provided
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 77, // default 77
            monstercat: false, // default false
            waves: false, // default false
        ),
        // this is a list of floating point numbers thats directly passed to cava
        // they are passed in order that they are defined
        eq: []
    ),
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "31%",
                        borders: "RIGHT",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "100%",
                                    borders: "NONE",
                                    border_symbols: Plain,
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (
                                                size: "100%",
                                                borders: "NONE",
                                                border_symbols: Plain,
                                                pane: Pane(AlbumArt)
                                            ),
                                            //(
                                            //    size: "1",
                                            //    pane: Pane(Empty())
                                            //),
                                        ],
                                    ),
                                ),
                                (
                                    size: "12",
                                    borders: "TOP",
                                    border_symbols: Inherited(parent: Plain, top_right: "┬", bottom_right: "┴"),
                                    border_title: [(kind: Text(" Lyrics ─"))],
                                    border_title_alignment: Right,
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (
                                                size: "100%",
                                                pane: Pane(Lyrics)
                                            ),
                                            //(
                                            //    size: "1",
                                            //    pane: Pane(Empty())
                                            //),
                                        ],
                                    ),
                                ),
                            ],
                        ),
                    ), 
                    (
                        size: "70%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "2",
                                    borders: "BOTTOM",
                                    border_symbols: Inherited(parent: Plain, bottom_left: "├", bottom_right: "┤",),
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (
                                                size: "1",
                                                pane: Pane(Empty())
                                            ),
                                            (
                                                size: "100%",
                                                pane: Pane(QueueHeader())
                                            ),
                                        ]
                                    )
                                ),
                                (
                                    size: "100%",
                                    borders: "BOTTOM",
                                    //border_symbols: Plain,
                                    border_symbols: Inherited(parent: Plain, bottom_left: "├", bottom_right: "┤",),
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (
                                                size: "1",
                                                pane: Pane(Empty())
                                            ),
                                            (
                                                size: "100%",
                                                pane: Pane(Queue)
                                            ),
                                        ]
                                    )
                                ),
                                (
                                    size: "1",
                                    pane: Pane(Empty()),
                                ),
                                (
                                    size: "9",
                                    borders: "NONE",
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (
                                                size: "1%",
                                                pane: Pane(Empty())
                                            ),
                                            (
                                                size: "99%",
                                                pane: Pane(Cava)
                                            ),
                                        ]
                                    ),
                                ),
                                (
                                    size: "1",
                                    pane: Pane(Empty()),
                                ),
                            ],
                        )
                    ),
                ],
            ),
        ),
        (
            name: "Artists",
            borders: "BOTTOM",
            border_symbols: Plain,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(AlbumArtists), size: "100%", borders: "BOTTOM", border_symbols: Plain)],
            )
        ),
        (
            name: "Albums",
            borders: "BOTTOM",
            border_symbols: Plain,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Albums), size: "100%", borders: "BOTTOM", border_symbols: Plain)],
            )
        ),
        (
            name: "Playlists",
            borders: "BOTTOM",
            border_symbols: Plain,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Playlists), size: "100%", borders: "BOTTOM", border_symbols: Plain)],
            )
        ),
        (
            name: "Search",
            borders: "BOTTOM",
            border_symbols: Plain,
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Search), size: "100%", borders: "BOTTOM", border_symbols: Plain)],
            )
        ),
    ],
)
